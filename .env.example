# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- VAIBHAV: core ---
# ANTHROPIC_API_KEY=
# AGENT_MODEL=
PORT=3000
DATA_DIR=./.data
DRY_RUN=true
# --- VAIBHAV: triggers ---
TRIGGER_DEDUPE_TTL_HOURS=72
TRIGGER_MAX_CONCURRENT_RUNS=2
TRIGGER_EMAIL_ALLOWLIST=
GITHUB_BOT_LOGIN=
# --- VAIBHAV: github ---
# GITHUB_TOKEN=  # bot token, fine-grained, single repo to start
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPO_ALLOWLIST=owner/repo1,owner/repo2
GITHUB_MAX_DIFF_CHARS=60000
# --- VAIBHAV: search ---
SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
SEARCH_CACHE_TTL_SECONDS=600
FETCH_PAGE_MAX_BYTES=1000000
# --- VAIBHAV: composio (v2 connector layer) ---
# COMPOSIO_API_KEY=  # starts with ak_, never commit
# COMPOSIO_API=https://backend.composio.dev/api/v3.1
# --- VAIBHAV: research port (Phase 6) ---
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=

# --- YASHWANTH: google / whatsapp / meetings (teammate owns these values) ---
# Yashwanth edits ONLY this block. Vaibhav never edits here.
# GOOGLE_* / WHATSAPP_* / meeting notifier keys go here.
# server/lib/google-auth.ts is CANCELLED in v2 (Composio handles OAuth)
# unless Phase 1 finds Composio cannot create Meet links.
# --- YASHWANTH: whatsapp (Phase 4) ---
# WHATSAPP_PROVIDER=cloud_api  # or twilio
# WHATSAPP_TOKEN=  # Cloud API bearer token, never commit
# WHATSAPP_PHONE_NUMBER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
